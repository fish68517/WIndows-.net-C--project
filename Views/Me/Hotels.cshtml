@model TourismPlatform.Models.HotelOrdersViewModel

@{
    ViewData["Title"] = "我的酒店订单";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>我的酒店订单</h2>
            <p class="text-muted">查看和管理您的所有酒店订单</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-controller="Hotels" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-building"></i> 浏览酒店
            </a>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="btn-group" role="group">
                <a asp-controller="Me" asp-action="Hotels" asp-route-status="" 
                   class="btn btn-outline-primary @(string.IsNullOrEmpty(Model.SelectedStatus) ? "active" : "")">
                    全部订单
                </a>
                <a asp-controller="Me" asp-action="Hotels" asp-route-status="PendingPay" 
                   class="btn btn-outline-warning @(Model.SelectedStatus == "PendingPay" ? "active" : "")">
                    待支付
                </a>
                <a asp-controller="Me" asp-action="Hotels" asp-route-status="Paid" 
                   class="btn btn-outline-success @(Model.SelectedStatus == "Paid" ? "active" : "")">
                    已支付
                </a>
                <a asp-controller="Me" asp-action="Hotels" asp-route-status="ToUse" 
                   class="btn btn-outline-info @(Model.SelectedStatus == "ToUse" ? "active" : "")">
                    待入住
                </a>
                <a asp-controller="Me" asp-action="Hotels" asp-route-status="Used" 
                   class="btn btn-outline-secondary @(Model.SelectedStatus == "Used" ? "active" : "")">
                    已入住
                </a>
            </div>
        </div>
    </div>

    @if (Model.Orders != null && Model.Orders.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover shadow-sm">
                <thead class="table-light">
                    <tr>
                        <th>订单号</th>
                        <th>酒店名称</th>
                        <th>房型</th>
                        <th>入住日期</th>
                        <th>离店日期</th>
                        <th>总价</th>
                        <th>状态</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td><strong>#@order.HotelOrderId</strong></td>
                            <td>@(order.RoomType?.Hotel?.Name ?? "未知酒店")</td>
                            <td>@(order.RoomType?.RoomTypeName ?? "未知房型")</td>
                            <td>@order.CheckInDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.CheckOutDate.ToString("yyyy-MM-dd")</td>
                            <td><strong class="text-danger">¥@order.TotalPrice.ToString("F2")</strong></td>
                            <td>
                                <span class="badge bg-@GetStatusBadgeClass(order.Status)">
                                    @GetStatusText(order.Status)
                                </span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-controller="Orders" asp-action="DetailHotel" asp-route-orderId="@order.HotelOrderId" 
                                       class="btn btn-outline-primary">详情</a>
                                    
                                    @if (order.Status.ToString() == "PendingPay")
                                    {
                                        <a asp-controller="Orders" asp-action="PayHotel" asp-route-orderId="@order.HotelOrderId" 
                                           class="btn btn-outline-success">支付</a>
                                        <form asp-controller="Orders" asp-action="RefundHotel" method="post" class="d-inline" onsubmit="return confirm('确定要取消未支付订单吗？');">
                                            <input type="hidden" name="orderId" value="@order.HotelOrderId" />
                                            <button type="submit" class="btn btn-outline-secondary">取消</button>
                                        </form>
                                    }

                                    @if (order.Status.ToString() == "Paid" || order.Status.ToString() == "ToUse")
                                    {
                                        <form asp-controller="Orders" asp-action="RefundHotel" method="post" class="d-inline" onsubmit="return confirm('确定要申请退款吗？');">
                                            <input type="hidden" name="orderId" value="@order.HotelOrderId" />
                                            <button type="submit" class="btn btn-outline-danger">退款</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">暂无相关订单</div>
    }
</div>

@functions {
    private string GetStatusBadgeClass(object status)
    {
        var statusStr = status?.ToString() ?? "";
        return statusStr switch
        {
            "Paid" => "success",
            "PendingPay" => "warning",
            "ToUse" => "info",
            "Used" => "secondary",
            "CheckedIn" => "secondary",
            "Cancelled" => "danger",
            "RefundRequested" => "warning", // 黄色显示申请中
            _ => "secondary"
        };
    }

    private string GetStatusText(object status)
    {
        var statusStr = status?.ToString() ?? "";
        return statusStr switch
        {
            "Paid" => "已支付",
            "PendingPay" => "待支付",
            "ToUse" => "待入住",
            "Used" => "已离店",
            "CheckedIn" => "已入住",
            "Cancelled" => "已取消",
            "RefundRequested" => "退款审核中",
            _ => statusStr
        };
    }
}