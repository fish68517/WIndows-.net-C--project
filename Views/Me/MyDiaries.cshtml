@model IEnumerable<TourismPlatform.Models.TravelDiary>

@{
    ViewData["Title"] = "我的游记";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>我的游记</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-controller="Diaries" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> 发布新游记
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var diary in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                <a asp-controller="Diaries" asp-action="Detail" asp-route-id="@diary.DiaryId" class="text-decoration-none">
                                    @diary.Title
                                </a>
                            </h5>
                            <p class="card-text text-muted">
                                @{
                                    var preview = diary.Content.Length > 100 ? diary.Content.Substring(0, 100) + "..." : diary.Content;
                                }
                                @preview
                            </p>
                            <div class="text-muted small">
                                <div>发布时间：@diary.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                                <div>最后更新：@diary.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                                <div>评论数：@diary.Comments?.Count ?? 0</div>
                            </div>
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-controller="Diaries" asp-action="Detail" asp-route-id="@diary.DiaryId" class="btn btn-sm btn-outline-primary">查看</a>
                            <a asp-controller="Diaries" asp-action="Edit" asp-route-id="@diary.DiaryId" class="btn btn-sm btn-outline-warning">编辑</a>
                            <form asp-controller="Diaries" asp-action="Delete" asp-route-id="@diary.DiaryId" method="post" style="display: inline;">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('确定要删除此游记吗？');">删除</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p>您还没有发布任何游记。</p>
            <a asp-controller="Diaries" asp-action="Create" class="btn btn-primary">发布第一篇游记</a>
        </div>
    }
</div>
