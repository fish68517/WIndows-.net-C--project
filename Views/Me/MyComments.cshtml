@model IEnumerable<TourismPlatform.Models.Comment>

@{
    ViewData["Title"] = "我的评论";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>我的评论</h2>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>评论对象</th>
                        <th>评论内容</th>
                        <th>评分</th>
                        <th>发布时间</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comment in Model)
                    {
                        <tr>
                            <td>
                                @if (comment.AttractionId.HasValue && comment.Attraction != null)
                                {
                                    <a asp-controller="Attractions" asp-action="Detail" asp-route-id="@comment.AttractionId" class="text-decoration-none">
                                        景点：@comment.Attraction.Name
                                    </a>
                                }
                                else if (comment.DiaryId.HasValue && comment.Diary != null)
                                {
                                    <a asp-controller="Diaries" asp-action="Detail" asp-route-id="@comment.DiaryId" class="text-decoration-none">
                                        游记：@comment.Diary.Title
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">已删除</span>
                                }
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 300px;" title="@comment.Content">
                                    @comment.Content
                                </div>
                            </td>
                            <td>
                                @if (comment.Rating.HasValue)
                                {
                                    <span class="badge bg-warning text-dark">
                                        @for (int i = 0; i < comment.Rating.Value; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </td>
                            <td>
                                <form asp-controller="Comments" asp-action="Delete" asp-route-commentId="@comment.CommentId" method="post" style="display: inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('确定要删除此评论吗？');">
                                        <i class="bi bi-trash"></i> 删除
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p>您还没有发表任何评论。</p>
        </div>
    }
</div>
