@model IEnumerable<TourismPlatform.Models.Attraction>

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>
                <i class="bi bi-heart"></i> 猜你喜欢
            </h2>
            <p class="text-muted">根据您的浏览和收藏记录为您推荐</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var attraction in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <!-- Attraction Image -->
                        <div class="position-relative" style="height: 250px; overflow: hidden;">
                            @if (attraction.Images != null && attraction.Images.Any())
                            {
                                <img src="@attraction.Images.FirstOrDefault()?.ImageUrl" 
                                     class="card-img-top" 
                                     alt="@attraction.Name"
                                     style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center" 
                                     style="width: 100%; height: 100%;">
                                    <span class="text-muted">暂无图片</span>
                                </div>
                            }
                        </div>

                        <div class="card-body">
                            <!-- Attraction Name -->
                            <h5 class="card-title">@attraction.Name</h5>

                            <!-- District -->
                            @if (attraction.District != null)
                            {
                                <p class="card-text">
                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt"></i> @attraction.District.Name
                                    </small>
                                </p>
                            }

                            <!-- Ticket Price -->
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="h5 mb-0 text-danger">¥@attraction.TicketPrice.ToString("F2")</span>
                                <small class="text-muted">门票价格</small>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top">
                            <a asp-controller="Attractions" 
                               asp-action="Detail" 
                               asp-route-id="@attraction.AttractionId"
                               class="btn btn-primary btn-sm w-100">
                                查看详情
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <p class="mb-0">浏览更多景点，我们会为您提供更好的推荐。</p>
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15) !important;
    }

    .card-title {
        font-weight: 600;
        color: #333;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>
