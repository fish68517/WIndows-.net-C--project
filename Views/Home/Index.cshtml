@{
    ViewData["Title"] = "首页";
}

<div class="bg-light rounded-3 mb-5" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?ixlib=rb-4.0.3&auto=format&fit=crop&w=1440&q=80'); background-size: cover; background-position: center; padding: 100px 0;">
    <div class="container py-5 text-center text-white">
        <h1 class="display-4 fw-bold">开启你的梦幻之旅</h1>
        <p class="lead mb-4">探索全球热门景点，预订舒适酒店，记录美好瞬间。</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="Attractions" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3 rounded-pill">浏览景点</a>
            <a asp-controller="Hotels" asp-action="Index" class="btn btn-outline-light btn-lg px-4 rounded-pill">预订酒店</a>
        </div>
    </div>
</div>

<div class="container marketing mb-5">
    <div class="row text-center">
        <div class="col-lg-4 mb-4">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 80px; height: 80px;">
                <i class="bi bi-geo-alt fs-2"></i>
            </div>
            <h2 class="fw-normal">热门景点</h2>
            <p>精选全球最美风景，一键购票，快速入园。</p>
            <p><a class="btn btn-secondary" asp-controller="Attractions" asp-action="Index">去看看 &raquo;</a></p>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 80px; height: 80px;">
                <i class="bi bi-house-heart fs-2"></i>
            </div>
            <h2 class="fw-normal">舒适住宿</h2>
            <p>从豪华酒店到温馨民宿，给您家一般的体验。</p>
            <p><a class="btn btn-secondary" asp-controller="Hotels" asp-action="Index">去预订 &raquo;</a></p>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="rounded-circle bg-info text-white d-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 80px; height: 80px;">
                <i class="bi bi-journal-richtext fs-2"></i>
            </div>
            <h2 class="fw-normal">旅行游记</h2>
            <p>分享您的旅行故事，参考他人的真实攻略。</p>
            <p><a class="btn btn-secondary" asp-controller="Diaries" asp-action="Index">写游记 &raquo;</a></p>
        </div>
    </div>
</div>

@if (false)
{
    <div class="container">
    <h3 class="border-bottom pb-2 mb-4">本季推荐</h3>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="card h-100 shadow-sm border-0 hover-card">
                <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="..." style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">阳光沙滩</h5>
                    <p class="card-text text-muted">享受夏日的阳光与海浪，放松身心的绝佳去处。</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="#" class="btn btn-outline-primary w-100 stretched-link">查看详情</a>
                </div>
            </div>
        </div>
        
        <div class="col">
            <div class="card h-100 shadow-sm border-0 hover-card">
                <img src="https://images.unsplash.com/photo-1519904981063-b0cf448d2332?auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="..." style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">精品酒店</h5>
                    <p class="card-text text-muted">五星级服务体验，给您极致的奢华享受。</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="#" class="btn btn-outline-primary w-100 stretched-link">立即预订</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm border-0 hover-card">
                <img src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="..." style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">山川湖海</h5>
                    <p class="card-text text-muted">探索大自然的鬼斧神工，感受徒步的乐趣。</p>
                </div>
                <div class="card-footer bg-transparent border-top-0">
                    <a href="#" class="btn btn-outline-primary w-100 stretched-link">查看攻略</a>
                </div>
            </div>
        </div>
    </div>
</div>
}
