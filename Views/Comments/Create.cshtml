@model TourismPlatform.Models.CreateCommentViewModel

@{
    ViewData["Title"] = "发表评论";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">发表评论</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <input type="hidden" asp-for="AttractionId" />

                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label"> <span class="text-danger"></span></label>
                            <div class="rating-input">
                        <div class="mb-3">
                                <label asp-for="Rating" class="form-label">评分 <span class="text-danger">*</span></label>
                                
                                <select asp-for="Rating" class="form-select" required>
                                    <option value="">-- 请选择评分 --</option>
                                    <option value="5">⭐⭐⭐⭐⭐ (5分 - 非常满意)</option>
                                    <option value="4">⭐⭐⭐⭐ (4分 - 满意)</option>
                                    <option value="3">⭐⭐⭐ (3分 - 一般)</option>
                                    <option value="2">⭐⭐ (2分 - 不满意)</option>
                                    <option value="1">⭐ (1分 - 非常差)</option>
                                </select>
                                
                                <span asp-validation-for="Rating" class="text-danger"></span>
                            </div>
                        </div>
                            <span asp-validation-for="Rating" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label">评论内容 <span class="text-danger">*</span></label>
                            <textarea asp-for="Content" class="form-control" rows="5" placeholder="请输入您的评论..."></textarea>
                            <small class="form-text text-muted">最多500个字符</small>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">提交评论</button>
                            <a asp-controller="Attractions" asp-action="Detail" asp-route-id="@Model.AttractionId" class="btn btn-secondary">取消</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rating-input .btn-group {
        display: flex;
        gap: 5px;
    }

    .rating-input .btn {
        padding: 8px 12px;
        font-size: 20px;
    }

    .rating-input .btn-check:checked + .btn {
        background-color: #ffc107;
        border-color: #ffc107;
        color: white;
    }

    .bi-star-fill {
        color: #ffc107;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
