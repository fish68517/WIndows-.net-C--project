@model TourismPlatform.Models.HotelOrderDetailViewModel

@{
    ViewData["Title"] = "订单详情 - " + Model.HotelName;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-receipt"></i> 酒店订单详情
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Order Status -->
                    <div class="alert alert-success mb-4">
                        <h5 class="mb-2">
                            <i class="bi bi-check-circle"></i> 支付成功
                        </h5>
                        <p class="mb-0">您的订单已成功支付，核销码已生成。请妥善保管核销码，入住时需要出示。</p>
                    </div>

                    <!-- Order Information -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">订单信息</h6>
                            <div class="mb-2">
                                <strong>订单号：</strong>
                                <code>@Model.HotelOrderId</code>
                            </div>
                            <div class="mb-2">
                                <strong>订单状态：</strong>
                                <span class="badge bg-success">@Model.Status</span>
                            </div>
                            <div class="mb-2">
                                <strong>创建时间：</strong>
                                @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                            </div>
                            <div class="mb-2">
                                <strong>支付时间：</strong>
                                @(Model.PaidAt.HasValue ? Model.PaidAt.Value.ToString("yyyy-MM-dd HH:mm:ss") : "未支付")
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">酒店信息</h6>
                            <div class="mb-2">
                                <strong>酒店名称：</strong>
                                @Model.HotelName
                            </div>
                            <div class="mb-2">
                                <strong>房型：</strong>
                                @Model.RoomTypeName
                            </div>
                            <div class="mb-2">
                                <strong>入住日期：</strong>
                                @Model.CheckInDate.ToString("yyyy-MM-dd")
                            </div>
                            <div class="mb-2">
                                <strong>离店日期：</strong>
                                @Model.CheckOutDate.ToString("yyyy-MM-dd")
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Pricing Information -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">价格信息</h6>
                            <div class="mb-2">
                                <strong>住宿晚数：</strong>
                                @((Model.CheckOutDate - Model.CheckInDate).Days) 晚
                            </div>
                            <div class="mb-2">
                                <strong>应付金额：</strong>
                                <span class="text-danger h5">¥@Model.TotalPrice.ToString("F2")</span>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Verify Code -->
                    <div class="alert alert-warning mb-4">
                        <h6 class="alert-heading mb-3">
                            <i class="bi bi-qr-code"></i> 核销码
                        </h6>
                        <div class="text-center mb-3">
                            <div class="p-3 bg-light rounded">
                                <code class="h5">@Model.VerifyCode</code>
                            </div>
                        </div>
                        <p class="mb-0 small">
                            <strong>重要提示：</strong>请妥善保管此核销码，入住时需要出示此码进行核销。您也可以在个人中心随时查看此订单。
                        </p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2">
                        <a asp-controller="Orders" asp-action="List" class="btn btn-primary">
                            <i class="bi bi-list"></i> 查看我的订单
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-house"></i> 返回首页
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tips -->
            <div class="card mt-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="bi bi-info-circle"></i> 入住提示
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>请在入住日期当天下午 3 点后办理入住手续</li>
                        <li>离店时间通常为上午 11 点，逾期可能产生额外费用</li>
                        <li>如需修改订单，请在入住前 24 小时联系酒店</li>
                        <li>如需取消订单，请在入住前 48 小时申请，否则可能无法退款</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bi {
        margin-right: 5px;
    }

    code {
        background-color: #f5f5f5;
        padding: 2px 6px;
        border-radius: 3px;
        font-family: 'Courier New', monospace;
    }

    .alert-warning {
        border-left: 4px solid #ffc107;
    }
</style>
