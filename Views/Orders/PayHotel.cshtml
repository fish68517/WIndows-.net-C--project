@model TourismPlatform.Models.PayHotelOrderViewModel

@{
    ViewData["Title"] = "支付订单 - " + Model.HotelName;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-credit-card-2-front me-2"></i>酒店收银台</h5>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <small class="text-muted text-uppercase">应付金额</small>
                        <h2 class="display-4 fw-bold text-success">¥@Model.TotalPrice.ToString("F2")</h2>
                        <span class="badge bg-light text-dark border">订单号：@Model.HotelOrderId</span>
                    </div>

                    <div class="list-group list-group-flush mb-4">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">入住酒店</span>
                            <span class="fw-bold text-end">@Model.HotelName</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">预订房型</span>
                            <span>@Model.RoomTypeName</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">入住日期</span>
                            <span>@Model.CheckInDate.ToString("MM-dd") 至 @Model.CheckOutDate.ToString("MM-dd")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">住宿晚数</span>
                            <span>@((Model.CheckOutDate - Model.CheckInDate).Days) 晚</span>
                        </div>
                    </div>

                    <form asp-action="PayHotel" method="post">
                        <input type="hidden" name="orderId" value="@Model.HotelOrderId" />

                        <div class="mb-4">
                            <label class="form-label text-muted small">选择支付方式</label>
                            <div class="d-grid gap-2">
                                <input type="radio" class="btn-check" name="paymentMethod" id="alipay" autocomplete="off"
                                   value="alipay" checked>
                                <label class="btn btn-outline-primary text-start" for="alipay">
                                    <i class="bi bi-alipay me-2"></i>支付宝
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                立即支付
                            </button>
                            <a asp-controller="Orders" asp-action="DetailHotel" asp-route-orderId="@Model.HotelOrderId" class="btn btn-link text-muted">稍后支付</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .btn-check:checked + .btn-outline-primary {
            background-color: #0d6efd;
            color: white;
        }
    </style>
}