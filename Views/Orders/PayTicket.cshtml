@model TourismPlatform.Models.PayTicketOrderViewModel

@{
    ViewData["Title"] = "支付订单";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-credit-card-2-front me-2"></i>订单收银台</h5>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <small class="text-muted text-uppercase">应付金额</small>
                        <h2 class="display-4 fw-bold text-success">¥@Model.TotalPrice.ToString("F2")</h2>
                        <span class="badge bg-light text-dark border">订单号：@Model.TicketOrderId</span>
                    </div>

                    <div class="list-group list-group-flush mb-4">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">游玩景点</span>
                            <span class="fw-bold">@Model.AttractionName</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">游玩日期</span>
                            <span>@Model.VisitDate.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">购票张数</span>
                            <span>@Model.Quantity 张</span>
                        </div>
                    </div>

                    <form asp-action="PayTicket" method="post">
                        <input type="hidden" name="orderId" value="@Model.TicketOrderId" />

                        <div class="mb-4">
                            <label class="form-label text-muted small">选择支付方式</label>
                            <div class="d-grid gap-2">
                                <input type="radio" class="btn-check" name="paymentMethod" id="alipay" autocomplete="off"
                                   value="alipay" checked>
                                <label class="btn btn-outline-primary text-start" for="alipay">
                                    <i class="bi bi-alipay me-2"></i>支付宝
                                </label>
                            </div>
                        </div>

                        @if(true) {

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success btn-lg">
                                    立即支付
                                </button>
                                <a asp-action="List" class="btn btn-link text-muted">取消并返回列表</a>
                            </div> 
                        }
                        
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>