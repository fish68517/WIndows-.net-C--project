@model TourismPlatform.Models.TicketOrder

@{
    ViewData["Title"] = "订单支付";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h4 class="mb-0"><i class="bi bi-wallet2 me-2"></i>收银台</h4>
                    <p class="mb-0 opacity-75">安全支付环境</p>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <p class="text-muted mb-1">订单金额</p>
                        <h2 class="text-danger fw-bold">¥@Model.TotalPrice.ToString("F2")</h2>
                        <div class="badge bg-light text-dark border mt-2">
                            订单号：@Model.TicketOrderId
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">预订景点</span>
                            <span class="fw-bold">@Model.Attraction?.Name</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">出行日期</span>
                            <span>@Model.VisitDate.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">购买数量</span>
                            <span>@Model.Quantity 张</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small">选择支付方式</label>
                        <div class="list-group">
                            <label class="list-group-item d-flex align-items-center gap-3">
                                <input class="form-check-input flex-shrink-0" type="radio" name="paymentMethod" checked>
                                <span class="d-flex align-items-center text-success">
                                    <i class="bi bi-wechat fs-4 me-2"></i> 微信支付
                                </span>
                            </label>
                            <label class="list-group-item d-flex align-items-center gap-3">
                                <input class="form-check-input flex-shrink-0" type="radio" name="paymentMethod">
                                <span class="d-flex align-items-center text-primary">
                                    <i class="bi bi-alipay fs-4 me-2"></i> 支付宝
                                </span>
                            </label>
                        </div>
                    </div>

                    <form asp-action="PayTicket" method="post">
                        <input type="hidden" name="id" value="@Model.TicketOrderId" />
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm">
                                确认支付 ¥@Model.TotalPrice.ToString("F2")
                            </button>
                            <a asp-action="Index" asp-controller="Home" class="btn btn-link text-muted">暂不支付，返回首页</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>