@model TourismPlatform.Models.TicketOrderDetailViewModel

@{
    ViewData["Title"] = "订单详情";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header @(Model.Status == "1" ? "bg-success" : "bg-secondary") text-white py-4 text-center">
                    <h3 class="mb-0 fw-bold">
                        @if (Model.Status == "1")
                        {
                            <i class="bi bi-check-circle-fill me-2"></i> <span>预订成功</span>
                        }
                        else
                        {
                            <i class="bi bi-clock-history me-2"></i> <span>@Model.Status</span>
                        }
                    </h3>
                    <p class="mb-0 opacity-75 mt-2">订单号：@Model.TicketOrderId</p>
                </div>

                <div class="card-body p-5">
                    @if (Model.Status == "1")
                    {
                        <div class="text-center mb-5 p-4 bg-light rounded-3 border border-dashed">
                            <h5 class="text-muted text-uppercase mb-3">入园核销码</h5>
                            
                            <div id="qrcode" class="d-flex justify-content-center mb-3"></div>
                            
                            <h2 class="display-6 fw-bold text-dark letter-spacing-2">@Model.VerifyCode</h2>
                            <small class="text-muted">请向工作人员出示此二维码或券码</small>
                        </div>
                    }

                    <div class="row g-4">
                        
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center">
                                <div class="icon-square bg-light text-primary rounded-3 me-3 p-3">
                                    <i class="bi bi-calendar-event fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">游玩日期</small>
                                    <h6 class="mb-0 fw-bold">@Model.VisitDate.ToString("yyyy-MM-dd")</h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center">
                                <div class="icon-square bg-light text-primary rounded-3 me-3 p-3">
                                    <i class="bi bi-ticket-perforated fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">购买数量</small>
                                    <h6 class="mb-0 fw-bold">@Model.Quantity 张</h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center">
                                <div class="icon-square bg-light text-primary rounded-3 me-3 p-3">
                                    <i class="bi bi-currency-yen fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">实付金额</small>
                                    <h6 class="mb-0 fw-bold text-danger">¥@Model.TotalPrice.ToString("F2")</h6>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-5">

                    <div class="d-grid gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-lg">返回首页</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var code = "@Model.VerifyCode";
        // 只有当有码且不是“未生成”时才生成二维码
        if (code && code !== "未生成") {
            new QRCode(document.getElementById("qrcode"), {
                text: code,
                width: 180,
                height: 180,
                colorDark : "#000000",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H
            });
        }
    });
</script>

<style>
    .letter-spacing-2 { letter-spacing: 2px; }
    .border-dashed { border-style: dashed !important; }
</style>