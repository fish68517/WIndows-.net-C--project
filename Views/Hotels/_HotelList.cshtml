@model IEnumerable<TourismPlatform.Models.Hotel>

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var hotel in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">@hotel.Name</h6>
                        @if (!string.IsNullOrWhiteSpace(hotel.Description))
                        {
                            <p class="card-text text-muted small">@hotel.Description</p>
                        }
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                @if (hotel.RoomTypes != null && hotel.RoomTypes.Any())
                                {
                                    var minPrice = hotel.RoomTypes.Min(r => r.PricePerNight);
                                    <span class="h6 text-danger mb-0">¥@minPrice.ToString("F2")</span>
                                    <small class="text-muted d-block">起价/晚</small>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(hotel.ContactPhone))
                            {
                                <div class="text-end">
                                    <small class="text-muted d-block">联系方式</small>
                                    <small>@hotel.ContactPhone</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <p class="mb-0">暂无周边酒店信息</p>
    </div>
}
