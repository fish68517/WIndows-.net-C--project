@model IEnumerable<TourismPlatform.Models.TravelDiary>

@{
    ViewData["Title"] = "游记列表";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>游记列表</h2>
        </div>
        <div class="col-md-6 text-end">
            @{
                var userId = Context.Session.GetInt32("UserId");
            }
            @if (userId.HasValue)
            {
                <a asp-action="Create" class="btn btn-primary">发布游记</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">登录后发布游记</a>
            }
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var diary in Model.OrderByDescending(d => d.CreatedAt))
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                <a asp-action="Detail" asp-route-id="@diary.DiaryId" class="text-decoration-none">
                                    @diary.Title
                                </a>
                            </h5>
                            <p class="card-text text-muted">
                                @{
                                    var preview = diary.Content.Length > 100 ? diary.Content.Substring(0, 100) + "..." : diary.Content;
                                }
                                @preview
                            </p>
                            <div class="text-muted small">
                                <div>作者：@diary.User?.Nickname</div>
                                <div>发布时间：@diary.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>

                                @{
                                int commentCount = 0;
                                if (diary.Comments != null)
                                {
                                    commentCount = diary.Comments.Count;
                                }
                             }
                            <div>评论数：@commentCount</div>
                        
                            </div>
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-action="Detail" asp-route-id="@diary.DiaryId" class="btn btn-sm btn-outline-primary">查看详情</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">
                    暂无游记，<a asp-action="Create">发布第一篇游记</a>吧！
                </div>
            </div>
        }
    </div>
</div>
