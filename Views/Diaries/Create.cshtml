@model TourismPlatform.Models.CreateDiaryViewModel

@{
    ViewData["Title"] = "发布游记";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">发布游记</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">标题 <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="请输入游记标题..." />
                            <small class="form-text text-muted">最多200个字符</small>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label">内容 <span class="text-danger">*</span></label>
                            <textarea asp-for="Content" class="form-control" rows="10" placeholder="请输入游记内容..."></textarea>
                            <small class="form-text text-muted">最多5000个字符</small>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        @if(false) {
                            <div class="mb-3">
                            <label asp-for="Images" class="form-label">上传图片</label>
                            <input asp-for="Images" type="file" class="form-control" multiple accept="image/*" />
                            <small class="form-text text-muted">支持多张图片上传，格式：JPG、PNG、GIF 等</small>
                            <div id="imagePreview" class="mt-3"></div>
                           </div>

                        }
                        

                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                            <button type="submit" class="btn btn-primary">发布游记</button>
                            <a asp-action="Index" class="btn btn-secondary">取消</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #imagePreview {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 10px;
    }

    .image-preview-item {
        position: relative;
        width: 100%;
        padding-bottom: 100%;
        overflow: hidden;
        border-radius: 4px;
        background-color: #f0f0f0;
    }

    .image-preview-item img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. 取消注释，尝试获取元素
            const imageInput = document.querySelector('input[type="file"][name="Images"]');
            const imagePreview = document.getElementById('imagePreview');

            // 2. 【核心修复】增加判断：只有当 imageInput 确实存在时，才添加事件监听
            if (imageInput) {
                imageInput.addEventListener('change', function (e) {
                    // 确保预览区域存在（防止潜在的报错）
                    if (!imagePreview) return;
                    
                    imagePreview.innerHTML = '';

                    const files = e.target.files;
                    for (let i = 0; i < files.length; i++) {
                        const file = files[i];
                        const reader = new FileReader();

                        reader.onload = function (event) {
                            const previewItem = document.createElement('div');
                            previewItem.className = 'image-preview-item';
                            previewItem.innerHTML = `<img src="${event.target.result}" alt="Preview" />`;
                            imagePreview.appendChild(previewItem);
                        };

                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>
}
