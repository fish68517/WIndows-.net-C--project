@model TourismPlatform.Models.TravelDiary

@{
    ViewData["Title"] = Model.Title;
    // 1. 统一定义，解决 "变量重复定义" 错误
    // 2. 使用 Context.Session 解决 "非静态字段" 错误
    var currentUserId = Context.Session.GetInt32("UserId");
    var currentAdminId = Context.Session.GetInt32("AdminUserId");
    
    bool isPageAuthor = currentUserId.HasValue && Model.UserId == currentUserId.Value;
    bool isPageAdmin = currentAdminId.HasValue;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h1 class="card-title mb-0">@Model.Title</h1>
                        
                        @if (isPageAuthor || isPageAdmin)
                        {
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@Model.DiaryId" class="btn btn-sm btn-warning">编辑</a>
                                <form asp-action="Delete" asp-route-id="@Model.DiaryId" method="post" style="display: inline;">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('确定要删除此游记吗？')">删除</button>
                                </form>
                            </div>
                        }
                    </div>
                    <div class="text-muted mb-3">
                        <small>
                            作者：@Model.User?.Nickname | 发布时间：@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            @if (Model.CreatedAt != Model.UpdatedAt)
                            {
                                <span>| 更新时间：@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                            }
                        </small>
                    </div>
                    <hr />
                    <div class="diary-content">
                        @Html.Raw(Model.Content)
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">评论</h5>
                </div>
                <div class="card-body">
                    @if (Model.Comments != null && Model.Comments.Count > 0)
                    {
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="comment-item mb-3 pb-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@comment.User?.Nickname</strong>
                                        <small class="text-muted d-block">@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                    </div>
                                    @{
                                        // 使用顶部定义的变量，不要重新定义 var
                                        bool isCommentAuthor = currentUserId.HasValue && comment.UserId == currentUserId.Value;
                                        // 管理员也可以删评论
                                    }
                                    @if (isCommentAuthor || isPageAdmin)
                                    {
                                        <form asp-controller="Comments" asp-action="Delete" asp-route-commentId="@comment.CommentId" method="post" style="display: inline;">
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('确定要删除此评论吗？')">删除</button>
                                        </form>
                                    }
                                </div>
                                <p class="mt-2 mb-0">@comment.Content</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">暂无评论</p>
                    }
                </div>
            </div>

            @if (currentUserId.HasValue)
            {
                <div class="card shadow-sm mt-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">发表评论</h5>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Comments" asp-action="CreateDiaryComment" method="post">
                            <input type="hidden" name="diaryId" value="@Model.DiaryId" />
                            <div class="mb-3">
                                <textarea name="content" class="form-control" rows="3" placeholder="请输入您的评论..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">发表评论</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-4">
                    <a asp-controller="Account" asp-action="Login">登录</a>后可以发表评论
                </div>
            }
        </div>
    </div>
</div>

<style>
    .diary-content {
        line-height: 1.8;
        font-size: 16px;
    }

    .diary-content img {
        max-width: 100%;
        height: auto;
        margin: 15px 0;
        border-radius: 4px;
    }

    .comment-item {
        padding-bottom: 15px;
    }

    .comment-item:last-child {
        border-bottom: none;
    }
</style>