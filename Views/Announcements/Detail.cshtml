@model TourismPlatform.Models.Announcement

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title mb-3">@Model.Title</h1>
                    <div class="text-muted mb-4">
                        <small>发布时间：@Model.PublishedAt.ToString("yyyy-MM-dd HH:mm:ss")</small>
                    </div>
                    <hr />
                    <div class="announcement-content">
                        @Html.Raw(Model.Content)
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a href="/Announcements/Index" class="btn btn-outline-primary">返回公告列表</a>
                <a href="/" class="btn btn-outline-secondary">返回首页</a>
            </div>
        </div>
    </div>
</div>

<style>
    .announcement-content {
        line-height: 1.8;
        font-size: 1.1rem;
    }
</style>
