@model IEnumerable<TourismPlatform.Models.Announcement>

@{
    ViewData["Title"] = "公告列表";
}

<div class="container mt-5">
    <h1 class="mb-4">公告列表</h1>

    @if (Model.Any())
    {
        <div class="list-group">
            @foreach (var announcement in Model)
            {
                <a href="/Announcements/Detail/@announcement.AnnouncementId" class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">@announcement.Title</h5>
                        <small class="text-muted">@announcement.PublishedAt.ToString("yyyy-MM-dd HH:mm")</small>
                    </div>
                    <p class="mb-1">@Html.Raw(announcement.Content.Length > 150 ? announcement.Content.Substring(0, 150) + "..." : announcement.Content)</p>
                </a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            暂无公告
        </div>
    }

    <div class="mt-4">
        <a href="/" class="btn btn-outline-primary">返回首页</a>
    </div>
</div>
