<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 智慧旅游平台</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm fixed-top">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-airplane-engines-fill me-2"></i>旅游平台
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">首页</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Attractions" asp-action="Index">景点门票</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Hotels" asp-action="Index">酒店预订</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Diaries" asp-action="Index">游记攻略</a>
                        </li>
                    </ul>
                    
                    <ul class="navbar-nav">
                        @{
                            var userId = Context.Session.GetInt32("UserId");
                            var userNickname = Context.Session.GetString("UserNickname");
                        }
                        @if (userId != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> @userNickname
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Me" asp-action="Dashboard">个人中心</a></li>
                                    <li><a class="dropdown-item" asp-controller="Me" asp-action="Tickets">我的门票</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">退出登录</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">登录</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-light text-primary ms-2 rounded-pill px-3" asp-controller="Account" asp-action="Register">注册</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-shrink-0" style="margin-top: 70px;">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-4 bg-dark text-white-50">
        <div class="container text-center">
            <p class="mb-1">&copy; 2026 - 旅游平台 TourismPlatform - 探索世界之美</p>
            <small>联系我们要：contact@tourism.com</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>