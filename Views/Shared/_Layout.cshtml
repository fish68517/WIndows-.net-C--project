<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 旅游平台111</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="d-flex" id="wrapper">
        <div class="border-end bg-dark text-white" id="sidebar-wrapper">
            <div class="sidebar-heading border-bottom bg-danger text-center py-3">
                <i class="bi bi-airplane-fill me-2"></i>旅游平台
            </div>
            <div class="list-group list-group-flush">
                
                <div class="text-white-50 small text-uppercase px-3 mt-3 mb-1">浏览业务</div>
                <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0">
                    <i class="bi bi-speedometer2 me-2"></i>首页概览
                </a>
                <a asp-controller="Attractions" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0">
                    <i class="bi bi-geo-alt me-2"></i>景点门票
                </a>
                <a asp-controller="Hotels" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0">
                    <i class="bi bi-building me-2"></i>酒店预订
                </a>

                <div class="text-white-50 small text-uppercase px-3 mt-3 mb-1">个人中心</div>
                <a asp-controller="Me" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0">
                    <i class="bi bi-person-circle me-2"></i>我的信息
                </a>

                <div class="text-white-50 small text-uppercase px-3 mt-3 mb-1">系统管理</div>
                <a asp-controller="Admin" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0">
                    <i class="bi bi-shield-lock me-2"></i>后台管理
                </a>
            </div>
        </div>

        <div id="page-content-wrapper" class="w-100 bg-light">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-3 shadow-sm">
                <div class="container-fluid">
                    <span class="navbar-text fw-bold text-primary">
                        当前位置：@ViewData["Title"]
                    </span>
                </div>
            </nav>

            <div class="container-fluid p-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>