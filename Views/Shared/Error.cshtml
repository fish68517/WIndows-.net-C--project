@model TourismPlatform.Models.ErrorViewModel

@using Microsoft.AspNetCore.Http.Extensions

@{
    ViewData["Title"] = "出错了";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 d-inline-block p-5" style="max-width: 600px;">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle text-warning display-1"></i>
        </div>
        <h2 class="fw-bold mb-3">哎呀，出了一点小问题</h2>
        <p class="text-muted mb-4">
            抱歉，系统在处理您的请求时遇到了意外错误。<br>
            如果是代码问题，请检查日志。
        </p>
        
        @if (Model != null && !string.IsNullOrEmpty(Model.RequestId))
        {
            <div class="alert alert-light border mb-4 text-start">
                <small class="text-muted d-block">Request ID:</small>
                <code class="text-danger">@Model.RequestId</code>
            </div>
        }

        <a href="/" class="btn btn-primary px-4 rounded-pill">
            <i class="bi bi-house-door me-2"></i>返回首页
        </a>
    </div>
</div>