@model TourismPlatform.Models.LoginViewModel

@{
    ViewData["Title"] = "用户登录";
    Layout = null; // 关键：禁用全局布局（侧边栏）
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 智慧旅游平台</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .auth-card {
            width: 100%;
            max-width: 400px;
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .auth-header {
            background: #3b7ddd;
            padding: 30px;
            text-align: center;
            color: white;
        }
        .auth-body {
            padding: 40px;
            background: white;
        }
        .form-control:focus {
            box-shadow: 0 0 0 0.25rem rgba(59, 125, 221, 0.25);
            border-color: #3b7ddd;
        }
        .btn-primary {
            background-color: #3b7ddd;
            border-color: #3b7ddd;
            padding: 10px;
            font-weight: 500;
        }
        .btn-primary:hover {
            background-color: #2f64b1;
            border-color: #2f64b1;
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <div class="auth-header">
            <h3 class="mb-0 fw-bold"><i class="bi bi-airplane-engines-fill me-2"></i>旅游平台</h3>
            <p class="mb-0 opacity-75">欢迎回来，请登录您的账户</p>
        </div>
        <div class="auth-body">
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show text-start" role="alert">
                    <small>登录失败，请检查输入信息。</small>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-muted small fw-bold">电子邮箱</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label text-muted small fw-bold">密码</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="请输入密码" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">立即登录</button>
                </div>

                <div class="text-center">
                    <p class="text-muted small mb-0">
                        还没有账号？ 
                        <a asp-action="Register" class="text-decoration-none fw-bold" style="color: #3b7ddd;">立即注册</a>
                    </p>
                    <hr class="my-4">
                  
                </div>
            </form>
        </div>
    </div>

    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>