@{
    ViewData["Title"] = "AI 对话助手";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">AI 对话助手</h5>
                </div>
                <div class="card-body">
                    <div id="chatBox" class="chat-box mb-3" style="height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 15px; border-radius: 5px; background-color: #f9f9f9;">
                        <div class="chat-message bot-message mb-3">
                            <div class="message-content">
                                <strong>AI 助手：</strong> 你好！我是旅游平台的 AI 助手。有什么我可以帮助你的吗？
                            </div>
                        </div>
                    </div>

                    <div class="input-group">
                        <input type="text" id="questionInput" class="form-control" placeholder="请输入你的问题..." />
                        <button class="btn btn-primary" type="button" id="sendBtn">发送</button>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <h6 class="mb-3">常见问题：</h6>
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="askQuestion('开放时间')">
                            景点开放时间是多少？
                        </button>
                    </div>
                    <div class="col-md-6 mb-2">
                        <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="askQuestion('门票价格')">
                            门票价格是多少？
                        </button>
                    </div>
                    <div class="col-md-6 mb-2">
                        <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="askQuestion('如何购票')">
                            如何购买门票？
                        </button>
                    </div>
                    <div class="col-md-6 mb-2">
                        <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="askQuestion('如何预订酒店')">
                            如何预订酒店？
                        </button>
                    </div>
                    <div class="col-md-6 mb-2">
                        <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="askQuestion('核销码')">
                            核销码是什么？
                        </button>
                    </div>
                    <div class="col-md-6 mb-2">
                        <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="askQuestion('如何发布游记')">
                            如何发布游记？
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-box {
        display: flex;
        flex-direction: column;
    }

    .chat-message {
        margin-bottom: 10px;
    }

    .message-content {
        padding: 10px 15px;
        border-radius: 5px;
        max-width: 80%;
    }

    .user-message .message-content {
        background-color: #007bff;
        color: white;
        margin-left: auto;
    }

    .bot-message .message-content {
        background-color: #e9ecef;
        color: #333;
    }
</style>

@section Scripts {
    <script>
        function askQuestion(question) {
            document.getElementById('questionInput').value = question;
            sendMessage();
        }

        document.getElementById('sendBtn').addEventListener('click', sendMessage);
        document.getElementById('questionInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        function sendMessage() {
            const question = document.getElementById('questionInput').value.trim();
            if (!question) {
                alert('请输入问题');
                return;
            }

            // Add user message to chat
            const chatBox = document.getElementById('chatBox');
            const userMessageDiv = document.createElement('div');
            userMessageDiv.className = 'chat-message user-message mb-3';
            userMessageDiv.innerHTML = `<div class="message-content"><strong>你：</strong> ${escapeHtml(question)}</div>`;
            chatBox.appendChild(userMessageDiv);

            // Clear input
            document.getElementById('questionInput').value = '';

            // Send request to server
            fetch('/Chat/Ask', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'question=' + encodeURIComponent(question)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const botMessageDiv = document.createElement('div');
                        botMessageDiv.className = 'chat-message bot-message mb-3';
                        botMessageDiv.innerHTML = `<div class="message-content"><strong>AI 助手：</strong> ${escapeHtml(data.answer)}</div>`;
                        chatBox.appendChild(botMessageDiv);
                    } else {
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'chat-message bot-message mb-3';
                        errorDiv.innerHTML = `<div class="message-content"><strong>AI 助手：</strong> 出错了，请重试。</div>`;
                        chatBox.appendChild(errorDiv);
                    }
                    // Scroll to bottom
                    chatBox.scrollTop = chatBox.scrollHeight;
                })
                .catch(error => {
                    console.error('Error:', error);
                    const errorDiv = document.createElement('div');
                    errorDiv.className = 'chat-message bot-message mb-3';
                    errorDiv.innerHTML = `<div class="message-content"><strong>AI 助手：</strong> 网络错误，请重试。</div>`;
                    chatBox.appendChild(errorDiv);
                    chatBox.scrollTop = chatBox.scrollHeight;
                });
        }

        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, m => map[m]);
        }
    </script>
}
