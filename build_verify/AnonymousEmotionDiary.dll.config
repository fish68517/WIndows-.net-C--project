<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Database Configuration -->
    <add key="DatabaseConnectionString" value="Data Source=AnonymousEmotionDiary.db;Version=3;" />
    <add key="DatabasePath" value="AnonymousEmotionDiary.db" />
    
    <!-- API Configuration -->
    <add key="LLMProvider" value="SiliconFlow" />
    <add key="LLMBaseUrl" value="https://api.siliconflow.cn/v1" />
    <add key="LLMApiKey" value="sk-kkqzlhkehosnzpixglqyhxtsjqbikocvtjixvkaggqybrmge" />
    <add key="LLMAPIEndpoint" value="https://api.siliconflow.cn/v1/chat/completions" />
    <add key="LLMAPIModel" value="tencent/Hunyuan-MT-7B" />
    <add key="LLMAPITimeout" value="30000" />
    <add key="LLMUserProfileMaxChars" value="12000" />
    
    <!-- Emotion Detection Configuration -->
    <add key="EmotionHighRiskThreshold" value="70" />
    <add key="EmotionIndexMin" value="0" />
    <add key="EmotionIndexMax" value="100" />
    
    <!-- Diary Configuration -->
    <add key="DiaryContentMaxLength" value="5000" />
    <add key="DiaryContentMinLength" value="1" />
    <add key="DiaryPreviewLength" value="100" />
    
    <!-- User Configuration -->
    <add key="UsernameMinLength" value="3" />
    <add key="UsernameMaxLength" value="20" />
    <add key="PasswordMinLength" value="8" />
    <add key="AdminDefaultUsername" value="admin" />
    <add key="AdminDefaultPassword" value="Admin@12345" />
    
    <!-- Logging Configuration -->
    <add key="LogFilePath" value="Logs" />
    <add key="LogLevel" value="Debug" />
    <add key="LogMaxFileSizeMB" value="10" />
    <add key="DebugLogFileName" value="debug.log" />
    <add key="ErrorLogFileName" value="error.log" />
    <add key="EmotionAnalysisLogFileName" value="emotion_analysis.log" />
  </appSettings>
</configuration>
