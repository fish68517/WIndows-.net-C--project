## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml

# Entity Framework
Migrations/

# User uploads
wwwroot/uploads/avatars/*
wwwroot/uploads/attractions/*
wwwroot/uploads/diaries/*
!wwwroot/uploads/avatars/.gitkeep
!wwwroot/uploads/attractions/.gitkeep
!wwwroot/uploads/diaries/.gitkeep

# Database files
*.mdf
*.ldf
*.ndf

# NuGet
*.nupkg
*.snupkg

# Local user-specific settings
appsettings.local.json
