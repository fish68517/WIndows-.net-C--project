@model TourismPlatform.Models.AdminVerifyListViewModel

@{
    ViewData["Title"] = "核销管理";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>核销管理</h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Tab Navigation -->
<ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link @(Model.OrderType == "ticket" ? "active" : "")" 
           href="@Url.Action("Index", "AdminVerify", new { area = "Admin", orderType = "ticket" })" 
           role="tab">
            <i class="bi bi-ticket-perforated"></i> 门票核销
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(Model.OrderType == "hotel" ? "active" : "")" 
           href="@Url.Action("Index", "AdminVerify", new { area = "Admin", orderType = "hotel" })" 
           role="tab">
            <i class="bi bi-building"></i> 酒店核销
        </a>
    </li>
</ul>

<!-- Verify Code Input Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">核销码输入</h5>
    </div>
    <div class="card-body">
        <form id="verifyForm" class="row g-3">
            <div class="col-md-8">
                <label for="verifyCode" class="form-label">输入核销码</label>
                <input type="text" class="form-control form-control-lg" id="verifyCode" name="code" 
                       placeholder="输入或扫描核销码" autocomplete="off" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="button" class="btn btn-primary w-100 btn-lg" id="verifyBtn">
                    <i class="bi bi-check-circle"></i> 核销
                </button>
            </div>
        </form>
        <div id="verifyMessage" class="mt-3"></div>
    </div>
</div>

<!-- Pending Verify Codes Table -->
<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">待核销订单列表</h5>
    </div>
    <div class="card-body">
        @if (Model.VerifyCodes.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>核销码</th>
                            <th>用户</th>
                            <th>@(Model.OrderType == "ticket" ? "景点" : "酒店")</th>
                            <th>订单日期</th>
                            <th>生成时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var code in Model.VerifyCodes)
                        {
                            <tr>
                                <td>
                                    <code class="bg-light p-2 rounded">@code.Code</code>
                                </td>
                                <td>
                                    <div>@code.UserNickname</div>
                                    <small class="text-muted">@code.UserEmail</small>
                                </td>
                                <td>@code.ItemName</td>
                                <td>
                                    <small class="text-muted">@code.OrderDate.ToString("yyyy-MM-dd HH:mm")</small>
                                </td>
                                <td>
                                    <small class="text-muted">@code.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                </td>
                                <td>
                                    <a asp-area="Admin" asp-controller="AdminVerify" asp-action="Detail" 
                                       asp-route-id="@code.VerifyCodeId" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> 详情
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">暂无待核销订单</h4>
                <p>目前没有待核销的@(Model.OrderType == "ticket" ? "门票" : "酒店")订单。</p>
            </div>
        }
    </div>
</div>

<script>
document.getElementById('verifyBtn').addEventListener('click', function() {
    const code = document.getElementById('verifyCode').value.trim();
    const messageDiv = document.getElementById('verifyMessage');
    
    if (!code) {
        messageDiv.innerHTML = '<div class="alert alert-warning">请输入核销码</div>';
        return;
    }

    fetch('@Url.Action("Verify", "AdminVerify", new { area = "Admin" })', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
        },
        body: 'code=' + encodeURIComponent(code)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            messageDiv.innerHTML = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                   data.message +
                                   '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
            document.getElementById('verifyCode').value = '';
            setTimeout(() => location.reload(), 1500);
        } else {
            messageDiv.innerHTML = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                                   data.message +
                                   '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
        }
    })
    .catch(error => {
        messageDiv.innerHTML = '<div class="alert alert-danger">核销失败: ' + error + '</div>';
    });
});

// Focus on input field when page loads
document.getElementById('verifyCode').focus();
</script>
