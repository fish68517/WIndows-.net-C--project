@model IEnumerable<TourismPlatform.Models.Comment>

@{
    ViewData["Title"] = "评论审核";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>评论审核管理</h1>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> 返回首页
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>用户</th>
                            <th style="width: 40%;">内容</th>
                            <th>类型</th>
                            <th>状态</th>
                            <th>发布时间</th>
                            <th class="text-end" style="min-width: 150px;">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comment in Model)
                        {
                            <tr>
                                <td>
                                    @if (comment.User != null)
                                    {
                                        <div class="fw-bold">@comment.User.Nickname</div>
                                        <small class="text-muted">ID: @comment.UserId</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">未知用户</span>
                                    }
                                </td>
                                <td>
                                    <span class="d-inline-block text-break" style="max-width: 350px;">
                                        @comment.Content
                                    </span>
                                </td>
                                <td>
                                    @if (comment.AttractionId.HasValue)
                                    {
                                        <span class="badge bg-info text-dark">景点</span>
                                    }
                                    else if (comment.DiaryId.HasValue)
                                    {
                                        <span class="badge bg-secondary">游记</span>
                                    }
                                </td>
                                
                                <td>
                                    @if (comment.Status == 0)
                                    {
                                        <span class="badge bg-warning text-dark">待审核</span>
                                    }
                                    else if (comment.Status == 1)
                                    {
                                        <span class="badge bg-success">已通过</span>
                                    }
                                    else if (comment.Status == 2)
                                    {
                                        <span class="badge bg-danger">已拒绝</span>
                                    }
                                </td>

                                <td>@comment.CreatedAt.ToString("MM-dd HH:mm")</td>
                                
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        
                                        @if (comment.Status != 1)
                                        {
                                            <form asp-action="Approve" asp-route-id="@comment.CommentId" method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="通过审核">
                                                    <i class="bi bi-check-lg"></i> 通过
                                                </button>
                                            </form>
                                        }

                                        @if (comment.Status != 2)
                                        {
                                            <form asp-action="Reject" asp-route-id="@comment.CommentId" method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="拒绝/下架">
                                                    <i class="bi bi-x-lg"></i> 拒绝
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="Delete" asp-route-id="@comment.CommentId" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('确定要彻底删除这条评论吗？此操作不可恢复。');" title="删除评论">
                                                <i class="bi bi-trash"></i> 删除
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">暂无评论数据</p>
            </div>
        }
    </div>
</div>