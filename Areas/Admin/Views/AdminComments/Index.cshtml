@model IEnumerable<TourismPlatform.Models.Comment>

@{
    ViewData["Title"] = "评论审核";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>评论审核</h1>
    <a asp-area="Admin" asp-controller="AdminHome" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> 返回首页
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>评论ID</th>
                            <th>评论者</th>
                            <th>评论内容</th>
                            <th>评分</th>
                            <th>关联类型</th>
                            <th>发布时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comment in Model)
                        {
                            <tr>
                                <td>@comment.CommentId</td>
                                <td>
                                    @if (comment.User != null)
                                    {
                                        <span>@comment.User.Nickname</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">未知用户</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 300px;" title="@comment.Content">
                                        @comment.Content
                                    </span>
                                </td>
                                <td>
                                    @if (comment.Rating.HasValue)
                                    {
                                        <span class="badge bg-warning text-dark">@comment.Rating ⭐</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (comment.AttractionId.HasValue)
                                    {
                                        <span class="badge bg-info">景点评论</span>
                                    }
                                    else if (comment.DiaryId.HasValue)
                                    {
                                        <span class="badge bg-secondary">游记评论</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <form method="post" asp-action="Delete" asp-route-id="@comment.CommentId" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('确定要删除这条评论吗？');">
                                            <i class="bi bi-trash"></i> 删除
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i> 暂无评论
            </div>
        }
    </div>
</div>
