@model TourismPlatform.Services.StatsData

@{
    ViewData["Title"] = "数据统计";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>@ViewData["Title"]</h1>
</div>

<!-- Key Metrics Row 1 -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5 class="card-title">总用户数</h5>
                <p class="card-text display-4">@Model.TotalUsers</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5 class="card-title">总景点数</h5>
                <p class="card-text display-4">@Model.TotalAttractions</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">总游记数</h5>
                <p class="card-text display-4">@Model.TotalDiaries</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h5 class="card-title">总评论数</h5>
                <p class="card-text display-4">@Model.TotalComments</p>
            </div>
        </div>
    </div>
</div>

<!-- Key Metrics Row 2 -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-danger text-white">
            <div class="card-body">
                <h5 class="card-title">总收藏数</h5>
                <p class="card-text display-4">@Model.TotalFavorites</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-secondary text-white">
            <div class="card-body">
                <h5 class="card-title">门票订单</h5>
                <p class="card-text display-4">@Model.TotalTicketOrders</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-secondary text-white">
            <div class="card-body">
                <h5 class="card-title">酒店订单</h5>
                <p class="card-text display-4">@Model.TotalHotelOrders</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5 class="card-title">总收入</h5>
                <p class="card-text display-4">¥@Model.TotalRevenue.ToString("F2")</p>
            </div>
        </div>
    </div>
</div>

<!-- Pending Orders -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card border-warning">
            <div class="card-header bg-warning text-white">
                <h5 class="mb-0">待支付订单</h5>
            </div>
            <div class="card-body">
                <p class="mb-2">
                    <strong>待支付门票订单：</strong>
                    <span class="badge bg-warning">@Model.PendingTicketOrders</span>
                </p>
                <p class="mb-0">
                    <strong>待支付酒店订单：</strong>
                    <span class="badge bg-warning">@Model.PendingHotelOrders</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">订单统计</h5>
            </div>
            <div class="card-body">
                <p class="mb-2">
                    <strong>总订单数：</strong>
                    <span class="badge bg-info">@(Model.TotalTicketOrders + Model.TotalHotelOrders)</span>
                </p>
                <p class="mb-0">
                    <strong>平均订单金额：</strong>
                    <span class="badge bg-info">
                        @{
                            var totalOrders = Model.TotalTicketOrders + Model.TotalHotelOrders;
                            var avgPrice = totalOrders > 0 ? (Model.TotalRevenue / totalOrders).ToString("F2") : "0.00";
                        }
                        ¥@avgPrice
                    </span>
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Top Attractions -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">热门景点趋势图</h5>
            </div>
            <div class="card-body">
                <canvas id="topAttractionsChart" style="max-height: 400px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Top Attractions Table -->
<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">热门景点排行（Top 10）</h5>
            </div>
            <div class="card-body">
                @if (Model.TopAttractions != null && Model.TopAttractions.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>排名</th>
                                    <th>景点名称</th>
                                    <th>浏览次数</th>
                                    <th>收藏数</th>
                                    <th>订单数</th>
                                    <th>评分总分</th>
                                    <th>综合热度</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rank = 1;
                                    foreach (var attraction in Model.TopAttractions)
                                    {
                                        var score = attraction.ViewCount + (attraction.FavoriteCount * 2) + (attraction.OrderCount * 3);
                                        <tr>
                                            <td><strong>@rank</strong></td>
                                            <td>@attraction.Name</td>
                                            <td>@attraction.ViewCount</td>
                                            <td>@attraction.FavoriteCount</td>
                                            <td>@attraction.OrderCount</td>
                                            <td>@attraction.TotalScore</td>
                                            <td>
                                                <span class="badge bg-success">@score</span>
                                            </td>
                                        </tr>
                                        rank++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">暂无数据</p>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        margin-bottom: 1rem;
    }

    .display-4 {
        font-weight: bold;
        margin: 0;
    }

    .card-body {
        padding: 1.5rem;
    }

    .table-responsive {
        border-radius: 0.25rem;
    }
</style>

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Load chart data
        fetch('/Admin/AdminStats/GetTopAttractionsChartData')
            .then(response => response.json())
            .then(data => {
                const ctx = document.getElementById('topAttractionsChart').getContext('2d');
                
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: data.labels,
                        datasets: data.datasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            title: {
                                display: true,
                                text: '热门景点数据对比'
                            },
                            legend: {
                                display: true,
                                position: 'top'
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: '数量'
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: '景点名称'
                                }
                            }
                        }
                    }
                });
            })
            .catch(error => console.error('Error loading chart data:', error));
    });
</script>
