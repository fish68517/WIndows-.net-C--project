@model TourismPlatform.Models.Announcement

@{
    ViewData["Title"] = "新增公告";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>新增公告</h1>
    <a asp-area="Admin" asp-controller="AdminAnnouncements" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> 返回列表
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">表单验证失败</h4>
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Title" class="form-label">公告标题 <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="请输入公告标题" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label">公告内容 <span class="text-danger">*</span></label>
                <textarea asp-for="Content" class="form-control" rows="8" placeholder="请输入公告内容" required></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
                <small class="form-text text-muted">支持多行文本，详细描述公告内容</small>
            </div>

            <div class="mb-3">
                <label asp-for="PublishedAt" class="form-label">发布时间 <span class="text-danger">*</span></label>
                <input asp-for="PublishedAt" class="form-control" type="datetime-local" required />
                <span asp-validation-for="PublishedAt" class="text-danger"></span>
                <small class="form-text text-muted">选择公告的发布时间</small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> 创建公告
                </button>
                <a asp-area="Admin" asp-controller="AdminAnnouncements" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> 取消
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
