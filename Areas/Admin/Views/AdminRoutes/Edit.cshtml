@model TourismPlatform.Models.TravelRoute

@{
    ViewData["Title"] = "编辑线路";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>编辑官方线路</h1>
    <a asp-area="Admin" asp-controller="AdminRoutes" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> 返回列表
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">表单验证失败</h4>
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <input type="hidden" asp-for="RouteId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">线路名称 <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="请输入线路名称" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">线路描述</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="请输入线路简要描述"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Itinerary" class="form-label">行程安排 <span class="text-danger">*</span></label>
                <textarea asp-for="Itinerary" class="form-control" rows="5" placeholder="请输入详细的行程安排，例如：&#10;第一天：景点A → 景点B&#10;第二天：景点C → 景点D&#10;..." required></textarea>
                <span asp-validation-for="Itinerary" class="text-danger"></span>
                <small class="form-text text-muted">支持多行文本，详细描述每天的行程</small>
            </div>

            <div class="mb-3">
                <label asp-for="AttractionIntroduction" class="form-label">景点介绍 <span class="text-danger">*</span></label>
                <textarea asp-for="AttractionIntroduction" class="form-control" rows="5" placeholder="请输入线路中各景点的详细介绍" required></textarea>
                <span asp-validation-for="AttractionIntroduction" class="text-danger"></span>
                <small class="form-text text-muted">介绍线路中包含的主要景点及其特色</small>
            </div>

            <div class="mb-3">
                <label asp-for="TransportSuggestion" class="form-label">交通建议 <span class="text-danger">*</span></label>
                <textarea asp-for="TransportSuggestion" class="form-control" rows="4" placeholder="请输入交通建议，例如：&#10;- 建议乘坐公交车或出租车&#10;- 自驾路线：..." required></textarea>
                <span asp-validation-for="TransportSuggestion" class="text-danger"></span>
                <small class="form-text text-muted">提供交通方式建议和路线指导</small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> 保存更改
                </button>
                <a asp-area="Admin" asp-controller="AdminRoutes" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> 取消
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
