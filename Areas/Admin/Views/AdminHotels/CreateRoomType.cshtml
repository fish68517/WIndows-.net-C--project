@model TourismPlatform.Models.HotelRoomType

@{
    ViewData["Title"] = "新增房型";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <div>
        <h1>新增房型</h1>
        <p class="text-muted">酒店：@ViewBag.Hotel.Name</p>
    </div>
    <a asp-area="Admin" asp-controller="AdminHotels" asp-action="ManageRoomTypes" asp-route-hotelId="@ViewBag.Hotel.HotelId" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> 返回房型列表
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">表单验证失败</h4>
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="RoomTypeName" class="form-label">房型名称 <span class="text-danger">*</span></label>
                    <input asp-for="RoomTypeName" class="form-control" placeholder="例如：标准间、豪华间、套房" required />
                    <span asp-validation-for="RoomTypeName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PricePerNight" class="form-label">每晚价格 <span class="text-danger">*</span></label>
                    <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" placeholder="请输入每晚价格" required />
                    <span asp-validation-for="PricePerNight" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Capacity" class="form-label">容纳人数 <span class="text-danger">*</span></label>
                <input asp-for="Capacity" class="form-control" type="number" placeholder="请输入容纳人数" required />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">房型介绍</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="请输入房型介绍"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> 创建房型
                </button>
                <a asp-area="Admin" asp-controller="AdminHotels" asp-action="ManageRoomTypes" asp-route-hotelId="@ViewBag.Hotel.HotelId" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> 取消
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
