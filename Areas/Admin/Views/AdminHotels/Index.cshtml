@model IEnumerable<TourismPlatform.Models.Hotel>

@{
    ViewData["Title"] = "酒店管理";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>酒店管理</h1>
    <a asp-area="Admin" asp-controller="AdminHotels" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> 新增酒店
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>酒店名称</th>
                    <th>地址</th>
                    <th>描述</th>
                    <th>联系方式</th>
            
                    <th>创建时间</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var hotel in Model)
                    {
                        <tr>
                            <td>
                                <strong>@hotel.Name</strong>
                            </td>
                            <td>
                                @hotel.Address
                            </td>
                            <td>
                                @if (hotel.Attraction != null)
                                {
                                    <span>@hotel.Attraction.Name</span>
                                }
                                else
                                {
                                    <span>@hotel.Description</span>
                                }
                            </td>
                            <td>
                                @hotel.ContactPhone
                            </td>
                      
                            <td>
                                @hotel.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-area="Admin" asp-controller="AdminHotels" asp-action="ManageRoomTypes" asp-route-hotelId="@hotel.HotelId" class="btn btn-info" title="管理房型">
                                        <i class="bi bi-door-closed"></i> 房型
                                    </a>
                                    <a asp-area="Admin" asp-controller="AdminHotels" asp-action="Edit" asp-route-id="@hotel.HotelId" class="btn btn-warning" title="编辑">
                                        <i class="bi bi-pencil"></i> 编辑
                                    </a>
                                    <form method="post" asp-area="Admin" asp-controller="AdminHotels" asp-action="Delete" asp-route-id="@hotel.HotelId" style="display:inline;" onsubmit="return confirm('确定要删除该酒店吗？');">
                                        <button type="submit" class="btn btn-danger" title="删除">
                                            <i class="bi bi-trash"></i> 删除
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            暂无酒店数据
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
