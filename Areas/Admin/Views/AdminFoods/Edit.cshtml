@model TourismPlatform.Models.Food

@{
    ViewData["Title"] = "编辑美食";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>编辑美食</h1>
    <a asp-area="Admin" asp-controller="AdminFoods" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> 返回列表
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">表单验证失败</h4>
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <input type="hidden" asp-for="FoodId" />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">美食名称 <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="请输入美食名称" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReferencePrice" class="form-label">参考价格 <span class="text-danger">*</span></label>
                    <input asp-for="ReferencePrice" class="form-control" type="number" step="0.01" placeholder="请输入参考价格" required />
                    <span asp-validation-for="ReferencePrice" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="AttractionId" class="form-label">所属景点</label>
                    <select asp-for="AttractionId" class="form-select">
                        <option value="">-- 请选择景点（可选） --</option>
                        @if (ViewBag.Attractions != null)
                        {
                            @foreach (var attraction in ViewBag.Attractions)
                            {
                                <option value="@attraction.AttractionId" selected="@(Model.AttractionId == attraction.AttractionId)">@attraction.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="AttractionId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DistrictId" class="form-label">所属区域</label>
                    <select asp-for="DistrictId" class="form-select">
                        <option value="">-- 请选择行政区（可选） --</option>
                        @if (ViewBag.Districts != null)
                        {
                            @foreach (var district in ViewBag.Districts)
                            {
                                <option value="@district.DistrictId" selected="@(Model.DistrictId == district.DistrictId)">@district.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="DistrictId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">美食介绍</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="请输入美食介绍"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContactPhone" class="form-label">联系方式</label>
                <input asp-for="ContactPhone" class="form-control" placeholder="请输入联系电话" />
                <span asp-validation-for="ContactPhone" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> 保存更改
                </button>
                <a asp-area="Admin" asp-controller="AdminFoods" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> 取消
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
