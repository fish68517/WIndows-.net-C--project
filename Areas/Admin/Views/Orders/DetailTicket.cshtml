@model TourismPlatform.Models.AdminTicketOrderDetailViewModel

@{
    ViewData["Title"] = "门票订单详情";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>门票订单详情</h1>
    <a asp-area="Admin" asp-controller="AdminOrders" asp-action="Index" asp-route-orderType="ticket" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> 返回列表
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">订单信息</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">订单号</label>
                        <p class="h6">#@Model.TicketOrderId</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">创建时间</label>
                        <p class="h6">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">用户昵称</label>
                        <p class="h6">@Model.UserNickname</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">用户邮箱</label>
                        <p class="h6">@Model.UserEmail</p>
                    </div>
                </div>

                <hr />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">景点名称</label>
                        <p class="h6">@Model.AttractionName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">访问日期</label>
                        <p class="h6">@Model.VisitDate.ToString("yyyy-MM-dd")</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">购票数量</label>
                        <p class="h6">@Model.Quantity 张</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">订单金额</label>
                        <p class="h6"><span class="badge bg-success">¥@Model.TotalPrice.ToString("F2")</span></p>
                    </div>
                </div>

                @if (Model.PaidAt.HasValue)
                {
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">支付时间</label>
                            <p class="h6">@Model.PaidAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">核销信息</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label text-muted">核销码</label>
                        <p class="h6 font-monospace">@Model.VerifyCode</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">订单状态</h5>
            </div>
            <div class="card-body">
                @{
                    var statusBadgeClass = Model.Status switch
                    {
                        "PendingPay" => "bg-warning",
                        "Paid" => "bg-info",
                        "ToUse" => "bg-primary",
                        "Used" => "bg-success",
                        "Cancelled" => "bg-danger",
                        _ => "bg-secondary"
                    };
                    var statusText = Model.Status switch
                    {
                        "PendingPay" => "待支付",
                        "Paid" => "已支付",
                        "ToUse" => "待使用",
                        "Used" => "已使用",
                        "Cancelled" => "已取消",
                        _ => Model.Status
                    };
                }
                <div class="mb-3">
                    <span class="badge @statusBadgeClass" style="font-size: 1.1rem; padding: 0.5rem 1rem;">@statusText</span>
                </div>

                <div class="mb-3">
                    <label class="form-label">更新状态</label>
                    <select class="form-select" id="statusSelect">
                        <option value="">选择新状态</option>
                        <option value="PendingPay">待支付</option>
                        <option value="Paid">已支付</option>
                        <option value="ToUse">待使用</option>
                        <option value="Used">已使用</option>
                        <option value="Cancelled">已取消</option>
                    </select>
                </div>

                <button type="button" class="btn btn-primary w-100 mb-2" onclick="updateStatus()">
                    <i class="bi bi-check-circle"></i> 更新状态
                </button>

                @if (Model.Status != "Cancelled")
                {
                    <button type="button" class="btn btn-danger w-100" onclick="cancelOrder()" data-bs-toggle="tooltip" title="取消订单并处理退款">
                        <i class="bi bi-x-circle"></i> 取消订单
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<script>
function updateStatus() {
    const newStatus = document.getElementById('statusSelect').value;
    if (!newStatus) {
        alert('请选择新状态');
        return;
    }

    if (confirm('确定要更新订单状态吗？')) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        
        fetch('@Url.Action("UpdateTicketStatus", "AdminOrders", new { area = "Admin" })', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-TOKEN': token || ''
            },
            body: new URLSearchParams({
                id: @Model.TicketOrderId,
                newStatus: newStatus,
                __RequestVerificationToken: token || ''
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert('错误: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('请求失败，请稍后重试');
        });
    }
}

function cancelOrder() {
    if (confirm('确定要取消该订单吗？此操作将处理退款。')) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        
        fetch('@Url.Action("CancelTicketOrder", "AdminOrders", new { area = "Admin" })', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-TOKEN': token || ''
            },
            body: new URLSearchParams({
                id: @Model.TicketOrderId,
                __RequestVerificationToken: token || ''
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert('错误: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('请求失败，请稍后重试');
        });
    }
}
</script>
