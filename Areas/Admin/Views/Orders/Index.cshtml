@model TourismPlatform.Models.AdminOrderListViewModel

@{
    ViewData["Title"] = "订单管理";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>订单管理</h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Tab Navigation -->
<ul class="nav nav-tabs mb-4" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link @(Model.OrderType == "ticket" ? "active" : "")" 
           href="@Url.Action("Index", "AdminOrders", new { area = "Admin", orderType = "ticket" })" 
           role="tab">
            <i class="bi bi-ticket-perforated"></i> 门票订单
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(Model.OrderType == "hotel" ? "active" : "")" 
           href="@Url.Action("Index", "AdminOrders", new { area = "Admin", orderType = "hotel" })" 
           role="tab">
            <i class="bi bi-building"></i> 酒店订单
        </a>
    </li>
</ul>

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <input type="hidden" name="orderType" value="@Model.OrderType" />
            <div class="col-md-3">
                <label for="statusFilter" class="form-label">按状态筛选</label>
                <select class="form-select" id="statusFilter" name="status" onchange="this.form.submit()">
                    <option value="">全部状态</option>
                    @if (Model.OrderType == "ticket")
                    {
                        <option value="PendingPay" @(Model.SelectedStatus == "PendingPay" ? "selected" : "")>待支付</option>
                        <option value="Paid" @(Model.SelectedStatus == "Paid" ? "selected" : "")>已支付</option>
                        <option value="ToUse" @(Model.SelectedStatus == "ToUse" ? "selected" : "")>待使用</option>
                        <option value="Used" @(Model.SelectedStatus == "Used" ? "selected" : "")>已使用</option>
                        <option value="Cancelled" @(Model.SelectedStatus == "Cancelled" ? "selected" : "")>已取消</option>
                    }
                    else
                    {
                        <option value="PendingPay" @(Model.SelectedStatus == "PendingPay" ? "selected" : "")>待支付</option>
                        <option value="Paid" @(Model.SelectedStatus == "Paid" ? "selected" : "")>已支付</option>
                        <option value="ToUse" @(Model.SelectedStatus == "ToUse" ? "selected" : "")>待使用</option>
                        <option value="CheckedIn" @(Model.SelectedStatus == "CheckedIn" ? "selected" : "")>已入住</option>
                        <option value="Used" @(Model.SelectedStatus == "Used" ? "selected" : "")>已使用</option>
                        <option value="Cancelled" @(Model.SelectedStatus == "Cancelled" ? "selected" : "")>已取消</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<!-- Export Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">导出订单</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="ExportToExcel" class="row g-3">
            <input type="hidden" name="orderType" value="@Model.OrderType" />
            <div class="col-md-3">
                <label for="startDate" class="form-label">开始日期</label>
                <input type="date" class="form-control" id="startDate" name="startDate" />
            </div>
            <div class="col-md-3">
                <label for="endDate" class="form-label">结束日期</label>
                <input type="date" class="form-control" id="endDate" name="endDate" />
            </div>
            <div class="col-md-3">
                <label for="filterAttractionId" class="form-label">@(Model.OrderType == "ticket" ? "景点" : "酒店")</label>
                <input type="text" class="form-control" id="filterAttractionId" 
                       name="@(Model.OrderType == "ticket" ? "attractionId" : "hotelId")" 
                       placeholder="输入ID（可选）" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-success w-100">
                    <i class="bi bi-download"></i> 导出为 Excel
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Orders Table -->
<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.OrderType == "ticket" && Model.TicketOrders.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>订单号</th>
                            <th>用户</th>
                            <th>景点</th>
                            <th>访问日期</th>
                            <th>数量</th>
                            <th>金额</th>
                            <th>状态</th>
                            <th>创建时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.TicketOrders)
                        {
                            <tr>
                                <td>
                                    <strong>#@order.TicketOrderId</strong>
                                </td>
                                <td>
                                    <div>@order.UserNickname</div>
                                    <small class="text-muted">@order.UserEmail</small>
                                </td>
                                <td>@order.AttractionName</td>
                                <td>@order.VisitDate.ToString("yyyy-MM-dd")</td>
                                <td>@order.Quantity 张</td>
                                <td>
                                    <span class="badge bg-success">¥@order.TotalPrice.ToString("F2")</span>
                                </td>
                                <td>
                                    @{
                                        var statusBadgeClass = order.Status switch
                                        {
                                            "PendingPay" => "bg-warning",
                                            "Paid" => "bg-info",
                                            "ToUse" => "bg-primary",
                                            "Used" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                        var statusText = order.Status switch
                                        {
                                            "PendingPay" => "待支付",
                                            "Paid" => "已支付",
                                            "ToUse" => "待使用",
                                            "Used" => "已使用",
                                            "Cancelled" => "已取消",
                                            _ => order.Status
                                        };
                                    }
                                    <span class="badge @statusBadgeClass">@statusText</span>
                                </td>
                                <td>
                                    <small class="text-muted">@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                </td>
                                <td>
                                    <a asp-area="Admin" asp-controller="AdminOrders" asp-action="DetailTicket" asp-route-id="@order.TicketOrderId" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> 详情
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (Model.OrderType == "hotel" && Model.HotelOrders.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>订单号</th>
                            <th>用户</th>
                            <th>酒店</th>
                            <th>房型</th>
                            <th>入住日期</th>
                            <th>离店日期</th>
                            <th>金额</th>
                            <th>状态</th>
                            <th>创建时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.HotelOrders)
                        {
                            <tr>
                                <td>
                                    <strong>#@order.HotelOrderId</strong>
                                </td>
                                <td>
                                    <div>@order.UserNickname</div>
                                    <small class="text-muted">@order.UserEmail</small>
                                </td>
                                <td>@order.HotelName</td>
                                <td>@order.RoomTypeName</td>
                                <td>@order.CheckInDate.ToString("yyyy-MM-dd")</td>
                                <td>@order.CheckOutDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge bg-success">¥@order.TotalPrice.ToString("F2")</span>
                                </td>
                                <td>
                                    @{
                                        var statusBadgeClass = order.Status switch
                                        {
                                            "PendingPay" => "bg-warning",
                                            "Paid" => "bg-info",
                                            "ToUse" => "bg-primary",
                                            "CheckedIn" => "bg-success",
                                            "Used" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                        var statusText = order.Status switch
                                        {
                                            "PendingPay" => "待支付",
                                            "Paid" => "已支付",
                                            "ToUse" => "待使用",
                                            "CheckedIn" => "已入住",
                                            "Used" => "已使用",
                                            "Cancelled" => "已取消",
                                            _ => order.Status
                                        };
                                    }
                                    <span class="badge @statusBadgeClass">@statusText</span>
                                </td>
                                <td>
                                    <small class="text-muted">@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                </td>
                                <td>
                                    <a asp-area="Admin" asp-controller="AdminOrders" asp-action="DetailHotel" asp-route-id="@order.HotelOrderId" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> 详情
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">暂无订单</h4>
                <p>目前还没有任何@(Model.OrderType == "ticket" ? "门票" : "酒店")订单。</p>
            </div>
        }
    </div>
</div>
