@model TourismPlatform.Models.Hotel

@{
    ViewData["Title"] = "新增酒店";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>新增酒店</h1>
    <a asp-area="Admin" asp-controller="AdminHotels" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> 返回列表
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">表单验证失败</h4>
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">酒店名称 <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="请输入酒店名称" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DistrictId" class="form-label">所属区域 <span class="text-danger">*</span></label>
                    <select asp-for="DistrictId" class="form-select" required>
                        <option value="">-- 请选择行政区 --</option>
                        @if (ViewBag.Districts != null)
                        {
                            @foreach (var district in ViewBag.Districts)
                            {
                                <option value="@district.DistrictId">@district.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="DistrictId" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="AttractionId" class="form-label">所属景点</label>
                    <select asp-for="AttractionId" class="form-select">
                        <option value="">-- 请选择景点（可选） --</option>
                        @if (ViewBag.Attractions != null)
                        {
                            @foreach (var attraction in ViewBag.Attractions)
                            {
                                <option value="@attraction.AttractionId">@attraction.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="AttractionId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactPhone" class="form-label">联系方式 <span class="text-danger">*</span></label>
                    <input asp-for="ContactPhone" class="form-control" placeholder="请输入联系电话" required />
                    <span asp-validation-for="ContactPhone" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">地址 <span class="text-danger">*</span></label>
                <input asp-for="Address" class="form-control" placeholder="请输入酒店地址" required />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">酒店介绍</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="请输入酒店介绍"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> 创建酒店
                </button>
                <a asp-area="Admin" asp-controller="AdminHotels" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> 取消
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
