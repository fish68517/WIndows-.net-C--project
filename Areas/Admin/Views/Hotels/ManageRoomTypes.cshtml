@model IEnumerable<TourismPlatform.Models.HotelRoomType>

@{
    ViewData["Title"] = "管理房型";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <div>
        <h1>@ViewBag.Hotel.Name - 房型管理</h1>
        <p class="text-muted">地址：@ViewBag.Hotel.Address</p>
    </div>
    <div class="btn-group" role="group">
        <a asp-area="Admin" asp-controller="AdminHotels" asp-action="CreateRoomType" asp-route-hotelId="@ViewBag.Hotel.HotelId" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> 新增房型
        </a>
        <a asp-area="Admin" asp-controller="AdminHotels" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> 返回酒店列表
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>房型名称</th>
                    <th>每晚价格</th>
                    <th>容纳人数</th>
                    <th>房型介绍</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var roomType in Model)
                    {
                        <tr>
                            <td>
                                <strong>@roomType.RoomTypeName</strong>
                            </td>
                            <td>
                                ¥@roomType.PricePerNight.ToString("F2")
                            </td>
                            <td>
                                <span class="badge bg-secondary">@roomType.Capacity 人</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(roomType.Description))
                                {
                                    <span>@roomType.Description.Substring(0, Math.Min(50, roomType.Description.Length))@(roomType.Description.Length > 50 ? "..." : "")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-area="Admin" asp-controller="AdminHotels" asp-action="EditRoomType" asp-route-roomTypeId="@roomType.RoomTypeId" class="btn btn-warning" title="编辑">
                                        <i class="bi bi-pencil"></i> 编辑
                                    </a>
                                    <form method="post" asp-area="Admin" asp-controller="AdminHotels" asp-action="DeleteRoomType" asp-route-roomTypeId="@roomType.RoomTypeId" style="display:inline;" onsubmit="return confirm('确定要删除该房型吗？');">
                                        <button type="submit" class="btn btn-danger" title="删除">
                                            <i class="bi bi-trash"></i> 删除
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            暂无房型数据
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
