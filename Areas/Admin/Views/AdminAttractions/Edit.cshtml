@model TourismPlatform.Models.Attraction

@{
    ViewData["Title"] = "编辑景点";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>编辑景点</h1>
    <a asp-area="Admin" asp-controller="AdminAttractions" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> 返回列表
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">表单验证失败</h4>
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <input type="hidden" asp-for="AttractionId" />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">景点名称 <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="请输入景点名称" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TicketPrice" class="form-label">门票价格 <span class="text-danger">*</span></label>
                    <input asp-for="TicketPrice" class="form-control" type="number" step="0.01" placeholder="请输入门票价格" required />
                    <span asp-validation-for="TicketPrice" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="DistrictId" class="form-label">所属区域 <span class="text-danger">*</span></label>
                    <select asp-for="DistrictId" class="form-select" required>
                        <option value="">-- 请选择行政区 --</option>
                        @if (ViewBag.Districts != null)
                        {
                            @foreach (var district in ViewBag.Districts)
                            {
                                <option value="@district.DistrictId" selected="@(Model.DistrictId == district.DistrictId)">@district.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="DistrictId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label">景点类型 <span class="text-danger">*</span></label>
                    <select asp-for="CategoryId" class="form-select" required>
                        <option value="">-- 请选择景点类型 --</option>
                        @if (ViewBag.Categories != null)
                        {
                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.CategoryId" selected="@(Model.CategoryId == category.CategoryId)">@category.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">景点介绍</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="请输入景点介绍"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="OpeningHours" class="form-label">开放时间</label>
                    <input asp-for="OpeningHours" class="form-control" placeholder="例如：09:00-17:00" />
                    <span asp-validation-for="OpeningHours" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactPhone" class="form-label">联系方式</label>
                    <input asp-for="ContactPhone" class="form-control" placeholder="请输入联系电话" />
                    <span asp-validation-for="ContactPhone" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">地址</label>
                <input asp-for="Address" class="form-control" placeholder="请输入景点地址" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TransportInfo" class="form-label">交通方式</label>
                <textarea asp-for="TransportInfo" class="form-control" rows="3" placeholder="请输入交通方式信息"></textarea>
                <span asp-validation-for="TransportInfo" class="text-danger"></span>
            </div>

            <!-- Existing Images Section -->
            @if (Model.Images != null && Model.Images.Any())
            {
                <div class="mb-4">
                    <h5>现有图片</h5>
                    <div class="row">
                        @foreach (var image in Model.Images.OrderBy(i => i.DisplayOrder))
                        {
                            <div class="col-md-3 mb-3">
                                <div class="card">
                                    <img src="@image.ImageUrl" class="card-img-top" alt="景点图片" style="height: 150px; object-fit: cover;" />
                                    <div class="card-body p-2">
                                        <button type="button" class="btn btn-sm btn-danger w-100" onclick="deleteImage(@image.ImageId)">
                                            <i class="bi bi-trash"></i> 删除
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- New Images Section -->
            <div class="mb-3">
                <label for="newImages" class="form-label">添加新图片</label>
                <input type="file" id="newImages" name="newImages" class="form-control" multiple accept="image/*" />
                <small class="form-text text-muted">支持多张图片上传，格式：JPG、PNG 等</small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> 保存更改
                </button>
                <a asp-area="Admin" asp-controller="AdminAttractions" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> 取消
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function deleteImage(imageId) {
            if (!confirm('确定要删除该图片吗？')) {
                return;
            }

            fetch('/Admin/AdminAttractions/DeleteImage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: `imageId=${imageId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('删除失败，请稍后重试');
            });
        }
    </script>
}
