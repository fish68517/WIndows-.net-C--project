@model IEnumerable<TourismPlatform.Models.TravelDiary>

@{
    ViewData["Title"] = "游记审核";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1>游记审核</h1>
    <a asp-area="Admin" asp-controller="AdminHome" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> 返回首页
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>游记ID</th>
                            <th>标题</th>
                            <th>作者</th>
                            <th>内容预览</th>
                            <th>发布时间</th>
                            <th>评论数</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var diary in Model)
                        {
                            <tr>
                                <td>@diary.DiaryId</td>
                                <td>
                                    <strong>@diary.Title</strong>
                                </td>
                                <td>
                                    @if (diary.User != null)
                                    {
                                        <span>@diary.User.Nickname</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">未知用户</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 300px;" title="@diary.Content">
                                        @diary.Content
                                    </span>
                                </td>
                                <td>@diary.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <span class="badge bg-info">@diary.Comments.Count</span>
                                </td>
                                <td>
                                    <a href="@Url.Action("Detail", "Diaries", new { id = diary.DiaryId })" class="btn btn-sm btn-info" target="_blank">
                                        <i class="bi bi-eye"></i> 查看
                                    </a>
                                    <form method="post" asp-action="Delete" asp-route-id="@diary.DiaryId" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('确定要删除这篇游记吗？');">
                                            <i class="bi bi-trash"></i> 删除
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i> 暂无游记
            </div>
        }
    </div>
</div>
